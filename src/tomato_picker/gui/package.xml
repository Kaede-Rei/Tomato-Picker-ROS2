<?xml version="1.0"?>
<package format="3">
  <name>tomato_picker_gui</name>
  <version>0.1.0</version>
  <description>Optional wrist RGB-D manual target selection GUI for Tomato-Picker</description>
  <maintainer email="kaerei@foxmail.com">Kaede Rei</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tomato_picker_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
