<?xml version="1.0"?>
<package format="3">
  <name>tomato_picker_bringup</name>
  <version>0.1.0</version>
  <description>System launch and configuration assembly for Tomato-Picker</description>
  <maintainer email="kaerei@foxmail.com">Kaede Rei</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>serial_arm_ros2_control</exec_depend>
  <exec_depend>tomato_picker_eef</exec_depend>
  <exec_depend>tomato_picker_motion</exec_depend>
  <exec_depend>tomato_picker_perception</exec_depend>
  <exec_depend>tomato_picker_task</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
